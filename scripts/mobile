#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="${1:-$root/target/mobile}"
profile="${PROFILE:-release}"

cd "$root"
cargo build -p cydonia-mobile --lib --target wasm32-unknown-unknown --profile "$profile"
wasm-bindgen --target web --no-typescript --remove-name-section \
  --out-dir "$out" "target/wasm32-unknown-unknown/$profile/cydonia_mobile.wasm"
if command -v wasm-opt >/dev/null && [ "$profile" = release ]; then
  wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext \
    --enable-mutable-globals --enable-reference-types \
    -o "$out/cydonia_mobile_bg.wasm" "$out/cydonia_mobile_bg.wasm"
fi
gzip -9 -k -f "$out/cydonia_mobile_bg.wasm" "$out/cydonia_mobile.js"

sans_dir="${SF_PRO_DIR:-$HOME/.local/share/fonts/SanFrancisco}"
mono_dir="${SF_MONO_DIR:-/usr/share/fonts/apple}"
geist_dir="${GEIST_DIR:-$HOME/.local/share/fonts/Geist}"
geist_mono_dir="${GEIST_MONO_DIR:-/usr/share/fonts/OTF}"
symbols_font="${SYMBOLS_FONT:-/usr/share/fonts/TTF/DejaVuSans.ttf}"
text_ranges="U+0000-024F,U+0300-036F,U+0370-03FF,U+0400-04FF,U+2000-20CF,U+2100-23FF,U+2460-27BF,U+2800-28FF,U+2B00-2BFF,U+FFFD"
mono_ranges="$text_ranges,U+E000-F8FF"

fonts="$out/fonts"
rm -rf "$fonts"
mkdir -p "$fonts"

cut_font() {
  local source="$1" target="$2" ranges="$3"
  [ -f "$source" ] || { echo "skipping $target: $source is missing" >&2; return 0; }
  pyftsubset "$source" --output-file="$fonts/$target" --unicodes="$ranges" \
    --layout-features='*' --name-IDs='*' --notdef-outline --no-hinting
  gzip -9 -k -f "$fonts/$target"
}

if command -v pyftsubset >/dev/null; then
  cut_font "$sans_dir/SF-Pro-Text-Regular.otf" sans-regular.otf "$text_ranges"
  cut_font "$sans_dir/SF-Pro-Text-RegularItalic.otf" sans-italic.otf "$text_ranges"
  cut_font "$sans_dir/SF-Pro-Text-Medium.otf" sans-medium.otf "$text_ranges"
  cut_font "$sans_dir/SF-Pro-Text-Semibold.otf" sans-semibold.otf "$text_ranges"
  cut_font "$sans_dir/SF-Pro-Text-Bold.otf" sans-bold.otf "$text_ranges"
  cut_font "$mono_dir/SFMonoNerdFontMono-Regular.otf" mono-regular.otf "$mono_ranges"
  cut_font "$mono_dir/SFMonoNerdFontMono-Bold.otf" mono-bold.otf "$mono_ranges"
  cut_font "$geist_dir/Geist-Regular.otf" geist-regular.otf "$text_ranges"
  cut_font "$geist_dir/Geist-Italic.otf" geist-italic.otf "$text_ranges"
  cut_font "$geist_dir/Geist-Medium.otf" geist-medium.otf "$text_ranges"
  cut_font "$geist_dir/Geist-SemiBold.otf" geist-semibold.otf "$text_ranges"
  cut_font "$geist_dir/Geist-Bold.otf" geist-bold.otf "$text_ranges"
  cut_font "$geist_mono_dir/GeistMonoNerdFontMono-Regular.otf" geist-mono-regular.otf "$mono_ranges"
  cut_font "$geist_mono_dir/GeistMonoNerdFontMono-Bold.otf" geist-mono-bold.otf "$mono_ranges"
  cut_font "$symbols_font" symbols.ttf "U+2190-23FF,U+25A0-27BF,U+2800-28FF,U+2B00-2BFF"
else
  echo "pyftsubset not found: the phone keeps its built in fonts" >&2
fi
version="$(cat "$out"/cydonia_mobile_bg.wasm "$out"/cydonia_mobile.js "$fonts"/* 2>/dev/null | sha256sum | cut -c1-12)"
sed "s/__VERSION__/$version/g" crates/mobile/index.html > "$out/index.html"
echo "$out ($version)"
